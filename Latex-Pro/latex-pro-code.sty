            { \prg_replicate:nn { 4 * \l__latexpro_depth_int } { \c_space_tl } }
          \l__latexpro_line_str
        }
      \bool_if:NT \l__latexpro_open_bool
        { \int_incr:N \l__latexpro_depth_int }
    \else
      % keep the file's own indentation
      \__latexpro_pseudo_math:N \l__latexpro_line_str
      \iow_now:Ne \g__latexpro_pseudo_iow { \l__latexpro_line_str }
    \fi
  }

% \latexprohyphenname{ADD-building-to-SKYLINE}: a name with hyphens in a
% pseudocode block, printed in one piece. It is a function name (small caps,
% function colour, like \method) when it follows function / procedure /
% algorithm or is written name( somewhere in the block, otherwise a variable
% (plain code text). Inside a comment or a string it is left as it is.
% the $...$ of mathescape interrupts listings' modes and keeps them in
% \lst@modestack: in plain code (not in a comment or a string) that holds
% only the Pmode every listing starts in
\tl_const:Nn \latexpro@plainmodes
  { { \lst@EnterMode { \lst@Pmode } { \lst@SelectCharTable } } }
\str_new:N \l__latexpro_hyphen_name_str
\NewDocumentCommand \latexprohyphenname { m }
  {
    \tl_if_eq:NNTF \lst@modestack \latexpro@plainmodes
      {
        \str_set:Ne \l__latexpro_hyphen_name_str { \str_foldcase:n {#1} }
        \legacy_if:nTF { latexpro@fn }
          { \global \latexpro@fnfalse \latexpro@functionstyle }
          {
            \seq_if_in:NVT \l__latexpro_code_hyphen_names_seq
              \l__latexpro_hyphen_name_str
              { \latexpro@functionstyle }
          }
      }
      { }
    #1
  }
% write the re-indented copy of #1 to \jobname-pseudo.tmp
\cs_new_protected:Npn \__latexpro_pseudo_prepare:n #1
  {
    \ior_open:Nn \g__latexpro_pseudo_ior {#1}
    \iow_open:Nn \g__latexpro_pseudo_iow { \c__latexpro_pseudo_file_str }
    \int_zero:N \l__latexpro_depth_int
    \int_zero:N \l__latexpro_pseudo_lineno_int
    \ior_str_map_inline:Nn \g__latexpro_pseudo_ior
      { \__latexpro_pseudo_line:n {##1} }
    \iow_close:N \g__latexpro_pseudo_iow
    \ior_close:N \g__latexpro_pseudo_ior
  }
% #1 star bool, #2 options, #3 file, #4 header text when there is no caption
\cs_new_protected:Npn \__latexpro_pseudo_input:Nnnn #1#2#3#4
  {
    \__latexpro_pseudo_prepare:n {#3}
    \__latexpro_code_box:nNnnnn { Pseudocode } #1 {#2} {#4} { latexpro-pseudo }
      { \c__latexpro_pseudo_file_str }
  }
\NewDocumentCommand \__latexpro_pseudo_cmd: {s O{} m}
  {
    \bool_set:Nn \l_tmpa_bool {#1}
    \__latexpro_pseudo_input:Nnnn \l_tmpa_bool {#2} {#3}
      { \__latexpro_code_file:n {#3} }
  }
% \begin{pseudo}[options] ... \end{pseudo}: the body is written verbatim to
% \jobname-pseudoenv.tmp and then handled like \pseudo; the header shows only
% the caption (there is no file name).  pseudo* drops the line numbers.
\str_const:Ne \c__latexpro_pseudoenv_file_str { \c_sys_jobname_str -pseudoenv.tmp }
\cs_new_protected:Npn \__latexpro_pseudoenv_run:Nn #1#2
  { \__latexpro_pseudo_input:Nnnn #1 {#2} { \c__latexpro_pseudoenv_file_str } { } }
\NewDocumentCommand \__latexpro_pseudoenv: { O{} }
  {
    \__latexpro_env_begin:nnn { \c__latexpro_pseudoenv_file_str }
      { \c_false_bool } {#1}
  }
\NewDocumentCommand \__latexpro_pseudoenv_star: { O{} }
  {
    \__latexpro_env_begin:nnn { \c__latexpro_pseudoenv_file_str }
      { \c_true_bool } {#1}
  }
\cs_new_protected:Npn \__latexpro_pseudoenv_end:
  { \__latexpro_env_end:N \__latexpro_pseudoenv_run:Nn }
% \pseudo is both a command (\pseudo{file.txt}) and an environment
% (\begin{pseudo} ... \end{pseudo}): \begin{pseudo} sets \@currenvir to
% "pseudo" before it calls \pseudo, which then starts the environment.
\str_const:Nn \c__latexpro_pseudo_env_str { pseudo }
\cs_new_protected:Npn \pseudo
  {
    \str_if_eq:VVTF \@currenvir \c__latexpro_pseudo_env_str
      { \__latexpro_pseudoenv: } { \__latexpro_pseudo_cmd: }
  }
\cs_new_protected:Npn \endpseudo { \__latexpro_pseudoenv_end: }
\cs_new_protected:cpn { pseudo* } { \__latexpro_pseudoenv_star: }
\cs_new_protected:cpn { endpseudo* } { \__latexpro_pseudoenv_end: }
% the same under a longer name
\cs_new_eq:NN \pseudocode \__latexpro_pseudoenv:
\cs_new_eq:NN \endpseudocode \__latexpro_pseudoenv_end:
\cs_new_eq:cc { pseudocode* } { pseudo* }
\cs_new_eq:cc { endpseudocode* } { endpseudo* }
% \variable{lo}: a variable in running text, written as in a pseudocode
% block: the code font and text colour; with a subscript or superscript
% (\variable{A_i}, \variable{a_{n+1}}) it is set as maths, as \pseudo does
\NewDocumentCommand \variable { m }
  {
    \regex_match:nnTF { \c[DU]. } {#1}
      {
        % letters and digits (A, length, n, 1) in the code font, the rest
        % (_ ^ + \alpha ...) as maths
        \tl_set:Nn \l_tmpa_tl {#1}
        % a name with hyphens (left-sum) stays one name, its "-" a hyphen
        \regex_replace_all:nnN
          { ( [A-Za-z][A-Za-z0-9]* (?: - [A-Za-z][A-Za-z0-9]* )+ | [A-Za-z0-9]+ ) }
          { \cB\{ \c{latexprocodemath} \cB\{ \1 \cE\} \cE\} } \l_tmpa_tl
        { \color{latexpro@text} \ensuremath { \l_tmpa_tl } }
      }
      { { \latexprocodefont \color{latexpro@text} #1 } }
  }
