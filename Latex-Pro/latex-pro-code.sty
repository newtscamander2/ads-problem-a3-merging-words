% latex-pro-code.sty -- Python and pseudocode listings (part of latex-pro)
%
% Usage:  \usepackage{latex-pro}  or  \usepackage{latex-pro-code}
%
% Commands
%   \python{code/solve.py}         include a .py file as highlighted Python in
%                                  an IDE-style box (listings + tcolorbox,
%                                  works with plain pdflatex)
%   \python[caption=Solver]{f.py}  caption/title go in the header bar, any
%                                  other listings option, e.g. firstline=5
%   \python*{f.py}                 same, without line numbers
%   (long boxes)                   a box taller than a page breaks across
%                                  pages by itself; a shorter one is kept in
%                                  one piece (moved to the next page)
%   \python[span]{f.py}            may always break; span=false: never
%   \python[edge=zigzag]{f.py}     the look of the edges where a page break
%                                  splits the box: wave (default), zigzag,
%                                  scallop, torn, fade, dashed, scissors,
%                                  continued, straight
%   \latexprocodesetup{edge=torn}  default options of every later block;
%                                  also \usepackage[edge=torn]{latex-pro}
%   \begin{pythoncode} ... \end{pythoncode}   Python typed in the .tex file
%                                  (pythoncode* without line numbers)
%   \py{x = 1}                     short inline Python inside a sentence
%   \method{merge}                 a function name in the text, styled like
%                                  function names in the code blocks
%   \variable{lo}  \variable{A_i}  a variable in the text, written as in a
%                                  pseudocode block
%   \pseudo{algo.txt}              include a pseudocode .txt file: keywords
%                                  (if/then/else/for/while/repeat/return/end
%                                  ...) highlighted, \geq \leq \gets <= != ... as
%                                  maths, and indented automatically
%   \pseudo[caption=..]{f.txt}  \pseudo*{f.txt}   same options as \python
%   \python[filename=false]{f.py}  no file name on the right of the header
%                                  (also \pseudo; caption=.. replaces it)
%   \begin{pseudo} ... \end{pseudo}   pseudocode typed in the .tex file,
%                                  same handling as \pseudo (also pseudo*,
%                                  and the longer name pseudocode)
%   \pseudoindentfalse             keep the file's own indentation
%   Restyle with \lstdefinestyle{latexpro-python}{...} (or latexpro-pseudo).
%
\NeedsTeXFormat{LaTeX2e}[2020/10/01]
\ProvidesPackage{latex-pro-code}[2026/11/05 v0.7 latex-pro: code listings]

\RequirePackage{listings}
\RequirePackage{amstext}
% \latexprocodemath{length}: text in the code font inside maths, at the right
% size for sub- and superscripts. Pseudocode subscripts (A_length) and
% \variable{A_i} use it, so every variable has the same font.
\newcommand\latexprocodemath[1]{\text{\latexprocodefont #1}}

% ---------------------------------------------------------------------------
% Look: IDE-style boxes (light mode)
% ---------------------------------------------------------------------------
% Every block is a rounded box with a header bar naming the language (and the
% caption or file name on the right), a rule under it, a monospace font and
% GitHub-light colours. Function names are in small caps. Change a colour with \definecolor after loading,
% e.g. \definecolor{latexpro@keyword}{HTML}{D73A49}, the font with
% \renewcommand\latexprocodefont{\ttfamily}, the box with
% \tcbset{latexpro-code/.append style={...}}.
\newcommand\latexprocodefont{\ttfamily}
% JetBrains Mono: with XeLaTeX or LuaLaTeX the code font is JetBrains Mono
% when it can be found, either installed on the computer or as the files
% JetBrainsMono-Regular.ttf (-Bold, -Italic, -BoldItalic) next to the .tex
% file (on Overleaf: upload them and pick XeLaTeX or LuaLaTeX). pdflatex
% cannot use it and keeps \ttfamily. A \renewcommand\latexprocodefont of your
% own is always kept. JetBrains Mono has no small caps, so function names use
% Latin Modern Mono Caps for those.
\let\latexpro@defaultcodefont\latexprocodefont
\ExplSyntaxOn
\tl_new:N \l__latexpro_code_sc_tl
\cs_new_protected:Npn \__latexpro_code_jetbrains:
  {
    \cs_if_eq:NNT \latexprocodefont \latexpro@defaultcodefont
      {
        \bool_lazy_or:nnTF { \sys_if_engine_xetex_p: } { \sys_if_engine_luatex_p: }
          {
            \@ifpackageloaded { fontspec } { } { \RequirePackage { fontspec } }
            % small caps for function names, from Latin Modern Mono Caps
            \tl_clear:N \l__latexpro_code_sc_tl
            \fontspec_font_if_exist:nTF { Latin~Modern~Mono~Caps }
              {
                \tl_set:Nn \l__latexpro_code_sc_tl
                  {
                    SmallCapsFont = { Latin~Modern~Mono~Caps } ,
                    SmallCapsFeatures = { Extension = { } , Scale = MatchLowercase } ,
                  }
              }
              {
                \fontspec_font_if_exist:nT { lmmonocaps10-regular.otf }
                  {
                    \tl_set:Nn \l__latexpro_code_sc_tl
                      {
                        SmallCapsFont = { lmmonocaps10-regular.otf } ,
                        SmallCapsFeatures = { Extension = { } , Scale = MatchLowercase } ,
                      }
                  }
              }
            \fontspec_font_if_exist:nTF { JetBrains~Mono }
              {
                \use:e
                  {
                    \exp_not:N \newfontfamily \exp_not:N \latexpro@jetbrains
                      { JetBrains~Mono }
                      [ Scale = MatchLowercase , \exp_not:V \l__latexpro_code_sc_tl ]
                  }
              }
              {
                \fontspec_font_if_exist:nTF { JetBrainsMono-Regular.ttf }
                  {
                    \use:e
                      {
                        \exp_not:N \newfontfamily \exp_not:N \latexpro@jetbrains
                          { JetBrainsMono }
                          [ Extension = .ttf ,
                            UprightFont = *-Regular , BoldFont = *-Bold ,
                            ItalicFont = *-Italic , BoldItalicFont = *-BoldItalic ,
                            Scale = MatchLowercase ,
                            \exp_not:V \l__latexpro_code_sc_tl ]
                      }
                  }
                  {
                    \PackageInfo { latex-pro-code }
                      { JetBrains~Mono~not~found:~code~uses~\string\ttfamily }
                  }
              }
            \cs_if_exist:NT \latexpro@jetbrains
              { \cs_set_eq:NN \latexprocodefont \latexpro@jetbrains }
          }
          {
            \PackageInfo { latex-pro-code }
              { JetBrains~Mono~needs~XeLaTeX~or~LuaLaTeX:~code~uses~\string\ttfamily }
          }
      }
  }
\ExplSyntaxOff
\AddToHook{begindocument/before}[latexpro/jetbrains]{\csname __latexpro_code_jetbrains:\endcsname}
% function / method names (merge in "function merge(A, B)", newton in
% "def newton(x)" and wherever they are called) are set in small caps, like
% \textsc{merge}; \renewcommand\latexprofunctionfont{} turns that off.
\newcommand\latexprofunctionfont{\scshape}
% the whole look of a function name, shared by listings and \method
\newcommand\latexpro@functionstyle{\color{latexpro@function}\latexprofunctionfont}
% \method{merge}: a function / method name in running text, in the same
% font, colour and small caps as in the code blocks
\NewDocumentCommand\method{m}{{\latexprocodefont\latexpro@functionstyle #1}}
\newif\iflatexpro@fn
\newcommand\latexpro@fnnext{\global\latexpro@fntrue}
% identifiers: the name right after def / class / function is a function name
\newcommand\latexpro@ident{%
  \iflatexpro@fn\global\latexpro@fnfalse\latexpro@functionstyle\fi}
% xcolor and tcolorbox are loaded at \begin{document} if the document has not
% loaded them, so \usepackage[...]{xcolor} anywhere in the preamble never gives
% an option clash.
\AddToHook{begindocument/before}{%
  \@ifpackageloaded{xcolor}{}{\RequirePackage{xcolor}}%
  \@ifpackageloaded{tcolorbox}{}{\RequirePackage{tcolorbox}}%
  \tcbuselibrary{breakable,skins}%
  \providecolor{latexpro@codebg}{HTML}{F6F8FA}%
  \providecolor{latexpro@codeframe}{HTML}{D0D7DE}%
  \providecolor{latexpro@header}{HTML}{24292F}%
  \providecolor{latexpro@headerinfo}{HTML}{57606A}%
  \providecolor{latexpro@text}{HTML}{24292F}%
  \providecolor{latexpro@keyword}{HTML}{CF222E}%
  \providecolor{latexpro@function}{HTML}{8250DF}%
  \providecolor{latexpro@builtin}{HTML}{8250DF}%
  \providecolor{latexpro@constant}{HTML}{0550AE}%
  \providecolor{latexpro@string}{HTML}{0A3069}%
  \providecolor{latexpro@comment}{HTML}{6E7781}%
  \providecolor{latexpro@number}{HTML}{8C959F}%
  \tcbset{latexpro-code/.style={
    colback=latexpro@codebg, colframe=latexpro@codeframe,
    colbacktitle=latexpro@codebg, coltitle=latexpro@header,
    fonttitle=\sffamily\small,
    boxrule=0.6pt, titlerule=0.6pt, arc=6pt,
    left=10pt, right=10pt, top=4pt, bottom=6pt,
    lefttitle=10pt, righttitle=10pt, toptitle=3pt, bottomtitle=3pt,
    before skip=\medskipamount, after skip=\medskipamount,
    % a box split over pages: the split edges are square and have no border
    % (the jigsaw skin draws only the outer edges); \latexpro@edge then
    % draws them in the box's edge style (wave by default, see below)
    enhanced jigsaw,
    latexpro-code-edge,
    extras first={sharp corners=south, overlay={\latexpro@edge{south}{1}}},
    extras middle={sharp corners,
      overlay={\latexpro@edge{south}{1}\latexpro@edge{north}{-1}}},
    extras last={sharp corners=north, overlay={\latexpro@edge{north}{-1}}}}}%
  % extra room between the code and a split edge, for the styles that draw
  % over it (fade, continued)
  \tcbset{latexpro-code-edge/.code={%
    \edef\latexpro@tmp{\csname latexpro@edgesep@\latexpro@edgestyle\endcsname}%
    \pgfkeysalso{topsep at break=\latexpro@tmp, bottomsep at break=\latexpro@tmp}}}%
  \providecolor{latexpro@pagebg}{named}{white}%
  \usetikzlibrary{fadings}%
  \@ifpackageloaded{pifont}{}{\IfFileExists{pifont.sty}{\RequirePackage{pifont}}{}}%
}
% ---------------------------------------------------------------------------
% Split edges: how a code box looks where a page break cuts it
% ---------------------------------------------------------------------------
% \latexpro@edge{south}{1} draws the bottom edge of a box part above a page
% break, \latexpro@edge{north}{-1} the top edge of the part below it, in the
% style \latexpro@edgestyle (the box option edge=..., or the document
% default from \latexprocodesetup{edge=...} / \usepackage[edge=...]{...}):
%
%   wave       a smooth sine wave (default)
%   zigzag     sharp teeth, like pinking shears
%   scallop    round lobes, like a cloud or a stamp edge
%   torn       an irregular jagged edge, like torn paper
%   fade       the box fades into the page
%   dashed     a dashed line, like a perforation
%   scissors   a dashed line with scissors on it (cut here)
%   continued  a straight open edge with "continued on next page" /
%              "continued from previous page"
%   straight   a straight open edge, nothing drawn
%
% The cut styles (wave, zigzag, scallop, torn) cut the edge by covering
% everything beyond the cut line (border included, so the side borders stop
% where the cut meets them) in the page colour (latexpro@pagebg).
% \latexprowaveheight is the height of the cut, \latexprowavelength one
% period of it at length=1; the box option length=x makes the period x
% times as long.
%
% The two edges of a page break fit together like puzzle pieces: each cut
% style has a profile p(t) between -1 and 1, t pt from the west side, and
% the cut lies 2h + s*h*p(t) in from the edge, for s = 1 (south) or -1
% (north). Where the bottom edge of one part bulges down, the top edge of
% the next part dips down, and the depth of the south edge plus that of
% the north edge is always 4h.
\newcommand\latexprowaveheight{1.8pt}
\newcommand\latexprowavelength{14pt}
% the fade style: how tall the fade is
\newcommand\latexprofadeheight{14pt}
% the continued style: the labels at the two edges of a page break
\newcommand\latexprocontinuedtext{continued on next page}
\newcommand\latexprocontinuedfromtext{continued from previous page}
\newcommand\latexpro@wavefactor{1}
\newcommand\latexpro@edgestyle{wave}
% extra space between the code and a split edge, per style
\def\latexpro@edgesep@wave{0pt}
\def\latexpro@edgesep@zigzag{0pt}
\def\latexpro@edgesep@scallop{0pt}
\def\latexpro@edgesep@torn{0pt}
\def\latexpro@edgesep@fade{6pt}
\def\latexpro@edgesep@dashed{0pt}
\def\latexpro@edgesep@scissors{0pt}
\def\latexpro@edgesep@continued{6pt}
\def\latexpro@edgesep@straight{0pt}
% profiles of the cut styles (t in pt, period \latexpro@wavel), and the
% distance between the points the cut line is drawn through, as a fraction
% of the period (zigzag and torn need their corners exactly)
\newcommand\latexpro@profile@wave[1]{sin((#1)/\latexpro@wavel*360)}
\def\latexpro@step@wave{0.125}
% zigzag: a triangle wave in step with the sine (0 at t=0, 1 at a quarter)
\newcommand\latexpro@profile@zigzag[1]{%
  (1-4*abs(mod((#1)/\latexpro@wavel+0.25,1)-0.5))}
\def\latexpro@step@zigzag{0.25}
% scallop: round lobes hanging down from the bottom edge, with a point
% between two lobes (the top edge gets round dips and points up)
\newcommand\latexpro@profile@scallop[1]{(1-2*abs(sin((#1)/\latexpro@wavel*180)))}
\def\latexpro@step@scallop{0.0625}
% torn: straight pieces between points a fifth of a period apart, each at a
% pseudo-random height; the same for every box, so both edges match
\newcommand\latexpro@profile@torn[1]{%
  (2*mod(abs(sin(round((#1)/(\latexpro@wavel/5))*12.9898+7)*437.585),1)-1)}
\def\latexpro@step@torn{0.2}
% \latexpro@depth{style}{s}{t}: how far in from the edge the cut lies
\newcommand\latexpro@depth[3]{%
  (2*\latexpro@waveh+(#2)*\latexpro@waveh*\csname latexpro@profile@#1\endcsname{#3})}
\newcommand\latexpro@wavedepth{\latexpro@depth{wave}}
\newdimen\latexpro@wavedim
\newcommand\latexpro@edge[2]{%
  \ifcsname latexpro@edge@\latexpro@edgestyle\endcsname
    \csname latexpro@edge@\latexpro@edgestyle\endcsname{#1}{#2}%
  \else
    \latexpro@edge@wave{#1}{#2}%
  \fi}
% \latexpro@cut{style}{south/north}{s}: cut the edge along the profile
\newcommand\latexpro@cut[3]{%
  % the width of the box, from its own west and east edges
  \pgfextractx\latexpro@wavedim{\pgfpointanchor{frame}{east}}%
  \pgfextractx\dimen@{\pgfpointanchor{frame}{west}}%
  \advance\latexpro@wavedim-\dimen@
  \pgfmathsetmacro\latexpro@wavewn{\latexpro@wavedim}%
  \pgfmathsetmacro\latexpro@waveh{\latexprowaveheight}%
  \pgfmathsetmacro\latexpro@wavel{\latexprowavelength*\latexpro@wavefactor}%
  \pgfmathsetmacro\latexpro@wavestep{\latexpro@wavel*\csname latexpro@step@#1\endcsname}%
  \pgfmathtruncatemacro\latexpro@waven{max(1,floor(\latexpro@wavewn/\latexpro@wavestep))}%
  % #3 = 1 for south (cut moves up from the edge), -1 for north (down)
  \def\latexpro@waves{#3}%
  \fill[latexpro@pagebg]
    ([xshift=-1pt,
      yshift={\latexpro@waves*\latexpro@depth{#1}{\latexpro@waves}{0}*1pt}]frame.#2 west)
    -- plot[domain=0:\latexpro@waven*\latexpro@wavestep,
            samples=\latexpro@waven+1, variable=\t]
       ([xshift=\t pt,
         yshift={\latexpro@waves*\latexpro@depth{#1}{\latexpro@waves}{\t}*1pt}]frame.#2 west)
    -- ([xshift=0pt,
         yshift={\latexpro@waves*\latexpro@depth{#1}{\latexpro@waves}{\latexpro@wavewn}*1pt}]frame.#2 east)
    -- ([xshift=1pt,
         yshift={\latexpro@waves*\latexpro@depth{#1}{\latexpro@waves}{\latexpro@wavewn}*1pt}]frame.#2 east)
    -- ([xshift=1pt, yshift=-\latexpro@waves*1pt]frame.#2 east)
    -- ([xshift=-1pt, yshift=-\latexpro@waves*1pt]frame.#2 west) -- cycle;}
\newcommand\latexpro@edge@wave{\latexpro@cut{wave}}
\newcommand\latexpro@edge@zigzag{\latexpro@cut{zigzag}}
\newcommand\latexpro@edge@scallop{\latexpro@cut{scallop}}
\newcommand\latexpro@edge@torn{\latexpro@cut{torn}}
% fade: page colour from fully covering at the edge to clear
% \latexprofadeheight in from it
\newcommand\latexpro@edge@fade[2]{%
  \fill[latexpro@pagebg, path fading=\ifnum#2>0 north\else south\fi]
    ([xshift=-1pt, yshift=-#2*1pt]frame.#1 west)
    rectangle ([xshift=1pt, yshift=#2*\latexprofadeheight]frame.#1 east);}
% dashed: a dashed line in the border colour where the border would be
\newcommand\latexpro@edge@dashed[2]{%
  \draw[latexpro@codeframe, line width=0.6pt, dash pattern=on 4pt off 3pt]
    ([yshift=#2*0.3pt]frame.#1 west) -- ([yshift=#2*0.3pt]frame.#1 east);}
% scissors: the dashed line, with scissors on the bottom edge cutting
% along it to the right (pifont's \ding{34}, mirrored; a cross if pifont is
% not installed)
\newcommand\latexpro@scissors{\ifdefined\ding\ding{34}\else$\times$\fi}
\newcommand\latexpro@edge@scissors[2]{%
  \latexpro@edge@dashed{#1}{#2}%
  \ifnum#2>0
    \node[fill=latexpro@pagebg, text=latexpro@headerinfo, inner sep=0.8pt,
          font=\small, xscale=-1, transform shape]
      at ([xshift=18pt, yshift=1pt]frame.#1 west)
      {\latexpro@scissors};
  \fi}
% continued: a label on the right, just inside the edge
\newcommand\latexpro@edge@continued[2]{%
  \node[anchor=\ifnum#2>0 south east\else north east\fi, inner sep=0pt,
        font=\sffamily\scriptsize\itshape, text=latexpro@headerinfo]
    at ([xshift=-10pt, yshift=#2*4pt]frame.#1 east)
    {\ifnum#2>0 \latexprocontinuedtext\else\latexprocontinuedfromtext\fi};}
\newcommand\latexpro@edge@straight[2]{}
% keywords and operators: listings also hands operators (otherkeywords such
% as = - +) inside comments and strings to keywordstyle, so colour them only
% in ordinary code (\lst@Pmode), never in a comment or a string
\newcommand\latexpro@keywordcolor{%
  \ifnum\lst@mode=\lst@Pmode\color{latexpro@keyword}\fi}
% the code font for listings: listings prints * - < > \ _ as plain
% characters only when the font is \ttdefault (otherwise it uses centred or
% maths symbols, which sit wrong in another monospace font such as JetBrains
% Mono), so the code font is made \ttdefault inside each listing
\newcommand\latexpro@listingfont{\latexprocodefont\edef\ttdefault{\f@family}}
% the parts every code style shares
\lstdefinestyle{latexpro-code}{
  basicstyle=\latexpro@listingfont\small\color{latexpro@text},
  identifierstyle=\latexpro@ident,
  keywordstyle=\latexpro@keywordcolor,
  keywordstyle=[2]\color{latexpro@builtin},
  keywordstyle=[3]\color{latexpro@constant},
  keywordstyle=[4]\color{latexpro@keyword}\latexpro@fnnext,
  stringstyle=\color{latexpro@string},
  commentstyle=\color{latexpro@comment}\itshape,
  emphstyle=\global\latexpro@fnfalse\latexpro@functionstyle,
  numbers=left,
  numberstyle=\scriptsize\latexprocodefont\color{latexpro@number},
  numbersep=1em,
  xleftmargin=1.6em,
  frame=none,
  aboveskip=0pt,
  belowskip=0pt,
  breaklines=true,
  breakatwhitespace=true,
  showstringspaces=false,
  tabsize=4,
  columns=fullflexible,
  keepspaces=true,
  upquote=true,
  % pdflatex: print the usual non-ASCII letters in code and comments
  extendedchars=true,
  literate=
    {æ}{{\ae}}1 {ø}{{\o}}1 {å}{{\aa}}1 {Æ}{{\AE}}1 {Ø}{{\O}}1 {Å}{{\AA}}1
    {ä}{{\"a}}1 {ö}{{\"o}}1 {ü}{{\"u}}1 {Ä}{{\"A}}1 {Ö}{{\"O}}1 {Ü}{{\"U}}1
    {é}{{\'e}}1 {è}{{\`e}}1 {ß}{{\ss}}1
    {—}{{-{}-}}1 {–}{{-}}1 {“}{{``}}1 {”}{{''}}1 {‘}{{`}}1 {’}{{'}}1
    {…}{{\ldots}}1 {×}{{$\times$}}1 {·}{{$\cdot$}}1
}

% ---------------------------------------------------------------------------
% Python code listings
% ---------------------------------------------------------------------------
\lstdefinestyle{latexpro-python}{
  style=latexpro-code,
  language=Python,
  deletekeywords={def,class,True,False,None,print},
  morekeywords={async,await,nonlocal,with,as,yield},
  % operators share the keyword colour
  otherkeywords={==,!=,<=,>=,**,//,+=,-=,*=,/=,->,=,+,-,*,/,\%,<,>,&,|,^,~,@},
  morekeywords=[2]{abs,all,any,bool,dict,enumerate,float,int,len,list,map,
    max,min,open,print,range,reversed,round,set,sorted,str,sum,tuple,type,
    zip,isinstance,super,input,filter,iter,next,repr,format,hash,id,divmod,pow},
  morekeywords=[3]{True,False,None,self,cls},
  morekeywords=[4]{def,class},
  morestring=[s]{"""}{"""},
  morestring=[s]{'''}{'''},
}
% \py{...}: same colours, no line numbers
\lstdefinestyle{latexpro-python-inline}{
  style=latexpro-python, numbers=none, basicstyle=\latexpro@listingfont\color{latexpro@text}}

\ExplSyntaxOn
% [caption=..] / [title=..] go in the header bar, every other option to listings
\tl_new:N \l__latexpro_code_caption_tl
\clist_new:N \l__latexpro_code_lst_clist
\tl_new:N \l__latexpro_code_span_tl
\box_new:N \l__latexpro_code_box
\bool_new:N \l__latexpro_code_filename_bool
\keys_define:nn { latexpro / code }
  {
    caption .tl_set:N = \l__latexpro_code_caption_tl ,
    title   .tl_set:N = \l__latexpro_code_caption_tl ,
    % span=auto (default): kept in one piece, unless it is taller than a
    % page, then it breaks across pages; [span] / span=true: may always
    % break; span=false: never breaks
    span    .choices:nn =
      { auto , true , false }
      { \tl_set_eq:NN \l__latexpro_code_span_tl \l_keys_choice_tl } ,
    span    .default:n  = true ,
    % [filename=false]: no file name on the right of the header bar
    filename .bool_set:N = \l__latexpro_code_filename_bool ,
    filename .default:n  = true ,
    % [length=x]: the wave on a split edge has x times the usual period
    length   .code:n     = { \tl_set:Nn \latexpro@wavefactor {#1} } ,
    % [edge=zigzag]: the look of the edges where the box is split
    edge     .choices:nn =
      { wave , zigzag , scallop , torn , fade , dashed , scissors , continued , straight }
      { \tl_set_eq:NN \latexpro@edgestyle \l_keys_choice_tl } ,
  }
% \latexprocodesetup{edge=zigzag, length=2}: the default options of every
% later code block (any option of \python, \pseudo, pythoncode and pseudo;
% a block's own options still win). Options of \usepackage{latex-pro} /
% \usepackage{latex-pro-code} with an = in them go here too, e.g.
% \usepackage[edge=torn]{latex-pro}. A second \latexprocodesetup adds to
% (and overrides) the first; inside a group it lasts to the end of the group.
\clist_new:N \l__latexpro_code_defaults_clist
\NewDocumentCommand \latexprocodesetup { m }
  {
    % set them once now, so a wrong value (edge=wavy) is reported here
    \group_begin:
      \keys_set_known:nnN { latexpro / code } {#1} \l__latexpro_code_lst_clist
    \group_end:
    \clist_put_right:Nn \l__latexpro_code_defaults_clist {#1}
  }
\AddToHook{begindocument/before}
  {
    \tcbset
      {
        latexpro-code-span/.code =
          {
            \str_if_eq:VnT \l__latexpro_code_span_tl { true }
              { \pgfkeysalso { breakable } }
          }
      }
  }
% Function names: every name written as name( or after def / class /
% function / procedure / algorithm somewhere in the file is coloured as a
