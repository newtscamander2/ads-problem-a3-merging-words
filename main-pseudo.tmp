function $\mbox{\latexprohyphenname{Is-Merge-Constituted}}$(M, B, x, y, z, i, j)
    if $\latexprocodemath{x}_{\latexprocodemath{length}}$ + $\latexprocodemath{z}_{\latexprocodemath{length}}$ != $\latexprocodemath{z}_{\latexprocodemath{length}}$ then //If the lengths of x and y are not the same, then it cannot be a merge of the two...
        return false
    end

    if i == 0 and j == 0 then
        M[i,j] = true
        return true
    end

    for a = 0 -> j-1 //Bottom up programming :)
        for b = 0 -> i-1
            $\mbox{\latexprohyphenname{Is-Merge-Constituted}}$(M, B, x, y, z, b, a)
        end
    end

    if i == 0 and j > 0 then
        M[i,j] = $\latexprocodemath{z}_{\latexprocodemath{j}}$ == $\latexprocodemath{y}_{\latexprocodemath{j}}$ and M[0,j-1]
        return M[i,j]
    end

    if i > 0 and j == 0 then
        M[i,j] = $\latexprocodemath{z}_{\latexprocodemath{i}}$ == $\latexprocodemath{x}_{\latexprocodemath{i}}$ and M[i-1,0]

        //Track B
        if M[i,j] == true then
            B[i] = true;
        end

        return M[i,j]
    end

    if i > 0 and j > 0 then
        M[i,j] = ($\latexprocodemath{z}_{\latexprocodemath{i+j}}$ == $\latexprocodemath{y}_{\latexprocodemath{j}}$ and M[i,j-1]) or ($\latexprocodemath{z}_{\latexprocodemath{i+j}}$ == $\latexprocodemath{x}_{\latexprocodemath{i}}$ and M[i-1,j])

        //Track B
        if M[i,j] == true and $\latexprocodemath{z}_{\latexprocodemath{i+j}}$ == $\latexprocodemath{x}_{\latexprocodemath{i}}$ then
            B[i+j] = true;
        end

        return M[i,j]
    end
end

function $\mbox{\latexprohyphenname{Print-Merge}}$(x, y,z)
    $\mbox{\latexprohyphenname{Is-Merge}}$ = $\mbox{\latexprohyphenname{Is-Merge-Constituted}}$(M, B, x, y, z, $\latexprocodemath{x}_{\latexprocodemath{length}}$, $\latexprocodemath{y}_{\latexprocodemath{length}}$)


    //Go through B and print if it is seen as a merge.
    if $\mbox{\latexprohyphenname{Is-Merge}}$ then
        for n = 1 -> $\latexprocodemath{z}_{\latexprocodemath{length}}$ do
            if B[n] then
                //Print
                print(n)
            end
        end
    end

end
