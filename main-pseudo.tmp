function $\mbox{\latexprohyphenname{Is-Merge-Constituted}}$(M, B, x, y, z)
    for i = 0 $\rightarrow$ $\latexprocodemath{x}_{\latexprocodemath{length}}$ to
        for j = 0 $\rightarrow$ $\latexprocodemath{y}_{\latexprocodemath{length}}$ to
            if i == 0 and j == 0 then
                M[i,j] = true

            if i == 0 and j > 0 then
                M[i,j] = $\latexprocodemath{z}_{\latexprocodemath{j}}$ == $\latexprocodemath{y}_{\latexprocodemath{j}}$ and M[0,j-1]

            if i > 0 and j == 0 then
                M[i,j] = $\latexprocodemath{z}_{\latexprocodemath{i}}$ == $\latexprocodemath{x}_{\latexprocodemath{i}}$ and M[i-1, 0]

                if M[i,j]  then
                    B[i,j] = "$\uparrow$"

            if i > 0 and j > 0 then
                if $\latexprocodemath{z}_{\latexprocodemath{i+j}}$ == $\latexprocodemath{x}_{\latexprocodemath{i}}$ and M[i-1,j] then
                    B[i,j] = "$\uparrow$"
                else if $\latexprocodemath{z}_{\latexprocodemath{i+j}}$ == $\latexprocodemath{z}_{\latexprocodemath{j}}$ and M[i,j-1] then
                    B[i,j] = "$\leftarrow$"

                M[i,j] = ($\latexprocodemath{z}_{\latexprocodemath{i+j}}$ == $\latexprocodemath{y}_{\latexprocodemath{j}}$ and M[i,j-1]) or ($\latexprocodemath{z}_{\latexprocodemath{i+j}}$ == $\latexprocodemath{x}_{\latexprocodemath{i}}$ and M[i-1,j])
    return M[$\latexprocodemath{x}_{\latexprocodemath{length}}$, $\latexprocodemath{y}_{\latexprocodemath{length}}$]

function $\mbox{\latexprohyphenname{Print-Merge}}$(M,B)
    i = $\latexprocodemath{M}_{\latexprocodemath{rows}}$
    j = $\latexprocodemath{M}_{\latexprocodemath{columns}}$

    while i > 0 and j > 0 do
        //
        if B[i,j] == "$\uparrow$" then
            if B[i-1, j] == "$\leftarrow$" then
                //Print
                print(i+j)
            i -= 1
        else if B[i,j] == "$\leftarrow$" then
            j -= 1
