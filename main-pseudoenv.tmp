	function Is-Merge-Constituted(M, B, x, y, z)
	for i = 0 \rightarrow x_{length} to
		for j = 0 \rightarrow y_{length} to
			if i == 0 and j == 0 then
				M[i,j] = true
			end

			if i == 0 and j > 0 then
				M[i,j] = z_j == y_j and M[0,j-1]
			end

			if i > 0 and j == 0 then
				M[i,j] = z_i == x_i and M[i-1, 0]

				if M[i,j]  then
					B[i,j] = "\uparrow"
				end
			end

			if i > 0 and j > 0 then
				if z_{i+j} == x_i and M[i-1,j] then
					B[i,j] = "\uparrow"
				else if z_{i+j} == z_j and M[i,j-1] then
					B[i,j] = "\leftarrow"
				end

				M[i,j] = (z_{i+j} == y_j and M[i,j-1]) or (z_{i+j} == x_i and M[i-1,j])
			end
		end
	end
	return M[x_length, y_length]
	end

	function Print-Merge(M,B)
		i = M_{rows}
		j = M_{columns}

		while i > 0 and j > 0 do
			//
			if B[i,j] == "\uparrow" then
				if B[i-1, j] == "\leftarrow" then
					//Print
					print(i+j)
				end
				i -= 1
			else if B[i,j] == "\leftarrow" then
				j -= 1
			end
		end
	end	
