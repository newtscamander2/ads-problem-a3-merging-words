	function Is-Merge-Constituted(M, B, x, y, z, i, j)
	if i == 0 and j == 0 then
	M[i,j] = true

	return true
	end

	for a = 0 -> j
	for b = 0 -> i
	Is-Merge(M, x, y, z, b, a)
	end
	end

	if i == 0 and j > 0 then
	M[i,j] = z_j == y_j and z_j == M[0,j-1]
	return M[i,j]
	end

	if i > 0 and j == 0 then
	M[i,j] = z_i == x_i and z_i == M[i-1,0]
	return M[i,j]
	end

	if i > 0 and j > 0 then
	M[i,j] = (z_{i+j} == y_j and z_{i+j} == M[i,j-1]) and (z_{i+j} == x_i and z_{i+j} == M[i-1,j])
	return M[i,j]

	// code in here
	end
	end

