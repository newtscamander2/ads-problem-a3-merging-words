	function Is-Merge-Constituted(M, B, x, y, z, i, j)
	if i == 0 and j == 0 then
	M[i,j] = true
	return true
	end

	for a = 0 -> j-1 //Bottom up programming :)
	for b = 0 -> i-1
	Is-Merge-Constituted(M, B, x, y, z, b, a)
	end
	end

	if i == 0 and j > 0 then
	M[i,j] = z_j == y_j and M[0,j-1]
	return M[i,j]
	end

	if i > 0 and j == 0 then
	M[i,j] = z_i == x_i and M[i-1,0]

	//Track B
	if M[i,j] == true then
	B[i] = true;
	end

	return M[i,j]
	end

	if i > 0 and j > 0 then
	M[i,j] = (z_{i+j} == y_j and M[i,j-1]) or (z_{i+j} == x_i and M[i-1,j])

	//Track B
	if M[i,j] == true and z_{i+j} == x_i then
	B[i+j] = true;
	end

	return M[i,j]
	end
	end

	function Print-Merge(x, y,z)
	Is-Merge-Constituted(M, B, x, y, z, x_length, y_length)

	//Go through B and print.
	for n = 1 -> z_length do
	if B[n] then
	//Print
	print(n)
	end
	end

	end
